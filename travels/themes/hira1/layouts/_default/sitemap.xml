{{- /* layouts/_default/sitemap.xml */ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{/* Home */}}
  <url>
    <loc>{{ .Site.Home.Permalink }}</loc>
    {{ with .Site.Home.Lastmod }}<lastmod>{{ .Format "2006-01-02" }}</lastmod>{{ end }}
  </url>
  {{- range .Site.Sections -}}
    <url>
      <loc>{{ .Permalink }}</loc>
      {{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02" }}</lastmod>{{ end }}
    </url>
  {{- end -}}
  {{- range .Site.RegularPages -}}
    <url>
      <loc>{{ .Permalink }}</loc>
      {{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02" }}</lastmod>{{ end }}
    </url>
  {{- end -}}
</urlset>
